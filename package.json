{
  "name": "forge-studio",
  "displayName": "Forge Studio",
  "description": "VS Code and Cursor extension that initializes a git superrepo for AI development: submodules, worktrees, and a project-local agent harness.",
  "version": "3.32.0",
  "license": "MIT",
  "author": "Alto9",
  "publisher": "alto9",
  "icon": "resources/icons/forge-logo.png",
  "keywords": [
    "forge",
    "superrepo",
    "submodules",
    "worktrees",
    "cursor",
    "ai",
    "agentic-development",
    "vscode",
    "github",
    "gitlab"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/alto9/forge"
  },
  "bugs": {
    "url": "https://github.com/alto9/forge/issues"
  },
  "homepage": "https://github.com/alto9/forge#readme",
  "engines": {
    "vscode": "^1.80.0",
    "node": ">=22.14.0",
    "npm": ">=10.0.0"
  },
  "categories": [
    "Other"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "forge.initializeSuperrepo",
        "title": "Forge: Initialize Superrepo"
      },
      {
        "command": "forge.updateHarness",
        "title": "Forge: Update Harness"
      },
      {
        "command": "forge.openSuperrepoConfig",
        "title": "Forge: Open Superrepo Config"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "webpack --mode production --devtool hidden-source-map && npm run build:webview",
    "compile": "webpack && npm run build:webview",
    "build": "webpack && npm run build:webview",
    "watch": "concurrently \"webpack --watch\" \"npm run dev:webview\"",
    "package": "npx @vscode/vsce package --no-dependencies",
    "build:webview": "esbuild src/webview/superrepo/index.tsx --bundle --outfile=media/superrepo/main.js --platform=browser --format=iife --target=es2020 --minify",
    "dev:webview": "esbuild src/webview/superrepo/index.tsx --bundle --outfile=media/superrepo/main.js --platform=browser --format=iife --target=es2020 --watch",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts,tsx",
    "test": "vitest run",
    "clean": "rm -rf dist out *.vsix node_modules",
    "release:dry-run": "semantic-release --dry-run",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.2",
    "@semantic-release/npm": "^13.1.2",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/node": "^22.14.0",
    "@types/react": "^18.2.73",
    "@types/react-dom": "^18.2.18",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/ui": "^4.0.15",
    "@vscode/vsce": "^3.2.1",
    "concurrently": "^8.2.2",
    "conventional-changelog-conventionalcommits": "^7.0.2",
    "esbuild": "0.19.12",
    "eslint": "^8.0.0",
    "happy-dom": "^20.0.11",
    "semantic-release": "^25.0.2",
    "ts-loader": "^9.5.4",
    "typescript": "^5.0.0",
    "vitest": "^4.0.15",
    "webpack": "^5.102.0",
    "webpack-cli": "^6.0.1"
  },
  "overrides": {
    "@actions/http-client": {
      "undici": "^6.24.0"
    }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
