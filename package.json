{
  "name": "forge-studio",
  "displayName": "Forge Studio by Alto9",
  "description": "Forge Agentic SDLC Harness and toolkit for Cursor.",
  "version": "3.32.0",
  "license": "MIT",
  "author": "Alto9",
  "publisher": "alto9",
  "icon": "resources/icons/forge-logo.png",
  "keywords": [
    "forge",
    "cursor",
    "plugin",
    "ai",
    "agentic-development",
    "vscode",
    "github"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/alto9/forge"
  },
  "bugs": {
    "url": "https://github.com/alto9/forge/issues"
  },
  "homepage": "https://github.com/alto9/forge#readme",
  "engines": {
    "vscode": "^1.80.0",
    "node": ">=22.14.0",
    "npm": ">=10.0.0"
  },
  "categories": [
    "Other"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "forge.syncCursorPlugin",
        "title": "Forge: Sync Cursor Plugin"
      },
      {
        "command": "forge.openCourse",
        "title": "Forge: Open Forge Course"
      }
    ],
    "configuration": {
      "title": "Forge",
      "properties": {
        "forge.cursorPlugin.repoUrl": {
          "type": "string",
          "default": "https://github.com/alto9/forge-cursor-plugin.git",
          "description": "Git remote cloned into ~/.cursor/plugins/local/forge-cursor."
        },
        "forge.cursorPlugin.autoUpdate": {
          "type": "boolean",
          "default": true,
          "description": "On startup, clone or fast-forward the Forge Cursor plugin in ~/.cursor/plugins/local."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "webpack --mode production --devtool hidden-source-map",
    "compile": "webpack",
    "build": "webpack",
    "watch": "webpack --watch",
    "package": "npx @vscode/vsce package --no-dependencies",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vitest run",
    "clean": "rm -rf dist out *.vsix node_modules",
    "release:dry-run": "semantic-release --dry-run",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.2",
    "@semantic-release/npm": "^13.1.2",
    "@types/node": "^22.14.0",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/ui": "^4.0.15",
    "@vscode/vsce": "^3.2.1",
    "conventional-changelog-conventionalcommits": "^7.0.2",
    "eslint": "^8.0.0",
    "semantic-release": "^25.0.2",
    "ts-loader": "^9.5.4",
    "typescript": "^5.0.0",
    "vitest": "^4.0.15",
    "webpack": "^5.102.0",
    "webpack-cli": "^6.0.1"
  },
  "overrides": {
    "@actions/http-client": {
      "undici": "^6.24.0"
    }
  }
}
